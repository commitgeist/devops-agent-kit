{
  "name": "subir-app",
  "description": "Orquestrador do fluxo de subir uma aplicação: confirma o contexto de entrega (cloud, IaC, CI/CD), delega a análise ao analyzer, apresenta o resultado e, após confirmação, delega containerizer, deployer e pipeliner em paralelo conforme o destino.",
  "prompt": "file://./instrucoes/subir-app.md",
  "tools": [
    "glob",
    "grep",
    "read",
    "subagent/analyzer",
    "subagent/containerizer",
    "subagent/deployer",
    "subagent/pipeliner"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep"
  ],
  "toolsSettings": {
    "crew": {
      "availableAgents": [
        "analyzer",
        "containerizer",
        "deployer",
        "pipeliner"
      ],
      "trustedAgents": [
        "analyzer"
      ]
    }
  },
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "file://~/.kiro/references/checklist-producao.md",
    "file://~/.kiro/references/padroes-do-time.md"
  ],
  "welcomeMessage": "subir-app pronto. Informe o que já souber (cloud, ferramenta de IaC, plataforma de CI/CD, destino) e o contexto do time de dev, ou use @real-contexto-entrega.",
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "**/*.pfx",
          "**/*.p12",
          "**/*.jks",
          "**/*.keystore",
          "**/id_rsa*",
          "**/id_ed25519*",
          "**/id_ecdsa*",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfvars",
          "**/.npmrc",
          "**/.pypirc",
          "**/.netrc",
          "**/.git-credentials",
          "**/.git/config",
          "**/credentials",
          "**/credentials*.json",
          "**/secret.*",
          "**/secrets.*",
          "**/.aws/**",
          "**/.azure/**",
          "**/.kube/**",
          "**/.ssh/**",
          "**/.gnupg/**",
          "**/.docker/config.json"
        ],
        "exclude": [
          "**/.env.example",
          "**/.env.sample",
          "**/.env.template",
          "**/*.tfvars.example"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "analyzer"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
    "fingerprint": "sha256:11515fdb102028533728b172fbbe619e262690f80bcc89280127b2c87921be03",
    "source": "sha256:eddc32710de72c8a41e72d83b6435805a180fe5b1c597e6a426e0f8c3ffbd016"
  },
  "hooks": [
    {
      "name": "guardrail-segredos",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "bash ~/.kiro/hooks/bloquear-segredos.sh"
      }
    }
  ]
}
