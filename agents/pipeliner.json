{
  "name": "pipeliner",
  "description": "Especialista: gera o pipeline de CI/CD com a skill gerar-pipeline na plataforma do contexto de entrega (GitHub Actions, Azure DevOps, Gitea Actions, Bitbucket, GitLab CI ou Jenkins). Sem shell; não dispara pipeline nem cria secrets.",
  "prompt": "file://./instrucoes/pipeliner.md",
  "tools": [
    "glob",
    "grep",
    "read",
    "write",
    "@mcp"
  ],
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "file://~/.kiro/references/README.md",
    "file://~/.kiro/references/padroes-do-time.md",
    "file://~/.kiro/references/checklist-producao.md",
    "file://~/.kiro/references/nomenclatura.md",
    "skill://~/.kiro/skills/gerar-pipeline/SKILL.md"
  ],
  "includeMcpJson": true,
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          ".github/workflows/**",
          ".gitea/workflows/**",
          "azure-pipelines*.yml",
          ".azuredevops/**",
          "bitbucket-pipelines.yml",
          ".gitlab-ci.yml",
          "Jenkinsfile",
          "docs/deploy/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-docs/*",
          "microsoft-learn/*",
          "terraform/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "github/*",
          "azure-devops/*",
          "gitea/*"
        ],
        "effect": "ask"
      }
    ]
  }
}
