{
  "name": "deployer",
  "description": "Gera artefatos de deploy com a skill gerar-deploy: manifests YAML puros para AKS (GitOps), Terraform para ECS ou Terraform de hospedagem estática (armazenamento + CDN). Nunca aplica nada e nunca usa latest.",
  "prompt": "file://./instrucoes/deployer.md",
  "tools": [
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "deploy/**",
        "docs/deploy/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "terraform fmt.*",
        "terraform validate.*",
        "terraform init -backend=false.*"
      ],
      "deniedCommands": [
        ".*terraform (apply|destroy|import|state).*",
        ".*\\bkubectl\\b.*",
        ".*\\bhelm\\b.*",
        ".*aws ecs .*",
        ".*\\baws s3\\b.*",
        ".*\\baws cloudfront\\b.*",
        ".*\\baz\\b.*"
      ],
      "denyByDefault": true
    }
  },
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "skill://~/.kiro/skills/gerar-deploy/SKILL.md",
    "file://~/.kiro/references/gitops.md",
    "file://~/.kiro/references/nomenclatura.md",
    "file://~/.kiro/references/checklist-producao.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "terraform fmt*",
          "terraform validate*",
          "terraform init -backend=false*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*terraform apply*",
          "*terraform destroy*",
          "*terraform import*",
          "*terraform state*",
          "*kubectl*",
          "*helm*",
          "*aws ecs *",
          "*aws s3*",
          "*aws cloudfront*",
          "az *",
          "* az *"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "terraform fmt*",
          "terraform init -backend=false*",
          "terraform validate*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "deploy/**",
          "docs/deploy/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
    "fingerprint": "sha256:d47bf10b88677a9a845f3f2af7225fc6835a030c01708d58cb184bae1e91d26e",
    "source": "sha256:2159d9c24e94b09f7b06d6e8148d17881ee1f8e8f8aa51aebca9d2b2f1213284"
  }
}
