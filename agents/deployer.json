{
  "name": "deployer",
  "description": "Especialista: gera IaC e manifests com a skill gerar-deploy na ferramenta do contexto de entrega (Terraform, OpenTofu, Bicep, Pulumi, CDK ou CloudFormation) para AKS, ECS ou hospedagem estática. Nunca aplica nada.",
  "prompt": "file://./instrucoes/deployer.md",
  "tools": [
    "glob",
    "grep",
    "read",
    "shell",
    "write",
    "@mcp"
  ],
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "file://~/.kiro/references/README.md",
    "file://~/.kiro/references/padroes-do-time.md",
    "file://~/.kiro/references/checklist-producao.md",
    "file://~/.kiro/references/nomenclatura.md",
    "file://~/.kiro/references/gitops.md",
    "skill://~/.kiro/skills/gerar-deploy/SKILL.md"
  ],
  "includeMcpJson": true,
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "deploy/**",
          "docs/deploy/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "terraform fmt*",
          "terraform validate*",
          "terraform init -backend=false*",
          "tofu fmt*",
          "tofu validate*",
          "tofu init -backend=false*",
          "bicep build*",
          "bicep lint*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*terraform apply*",
          "*terraform destroy*",
          "*terraform import*",
          "*terraform state*",
          "*kubectl*",
          "*helm*",
          "*aws ecs *",
          "*aws s3*",
          "*aws cloudfront*",
          "az *",
          "* az *",
          "*tofu apply*",
          "*tofu destroy*",
          "*pulumi up*",
          "*pulumi destroy*",
          "*cdk deploy*",
          "*cdk destroy*",
          "*aws cloudformation*",
          "*az deployment*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "terraform fmt*",
          "terraform validate*",
          "terraform init -backend=false*",
          "tofu fmt*",
          "tofu validate*",
          "tofu init -backend=false*",
          "bicep build*",
          "bicep lint*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-docs/*",
          "microsoft-learn/*",
          "terraform/*"
        ],
        "effect": "allow"
      }
    ]
  }
}
