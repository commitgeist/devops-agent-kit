{
  "name": "deployer",
  "description": "Gera artefatos de deploy com a skill gerar-deploy: manifests YAML puros para AKS (GitOps) ou Terraform para ECS. Nunca aplica nada e nunca usa latest.",
  "prompt": "file://./instrucoes/deployer.md",
  "tools": ["read", "glob", "grep", "write", "shell"],
  "allowedTools": ["read", "glob", "grep"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["deploy/**", "docs/deploy/**"]
    },
    "shell": {
      "allowedCommands": ["terraform fmt.*", "terraform validate.*", "terraform init -backend=false.*"],
      "deniedCommands": [".*terraform (apply|destroy|import|state).*", ".*\\bkubectl\\b.*", ".*\\bhelm\\b.*", ".*aws ecs .*"],
      "denyByDefault": true
    }
  },
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "skill://~/.kiro/skills/gerar-deploy/SKILL.md",
    "file://~/.kiro/references/gitops.md",
    "file://~/.kiro/references/nomenclatura.md",
    "file://~/.kiro/references/checklist-producao.md"
  ]
}
