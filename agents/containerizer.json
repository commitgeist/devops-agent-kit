{
  "name": "containerizer",
  "description": "Especialista: gera ou revisa Dockerfile e .dockerignore com a skill gerar-dockerfile. Só roda quando o destino exige container.",
  "prompt": "file://./instrucoes/containerizer.md",
  "tools": [
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "file://~/.kiro/references/README.md",
    "file://~/.kiro/references/padroes-do-time.md",
    "file://~/.kiro/references/checklist-producao.md",
    "skill://~/.kiro/skills/gerar-dockerfile/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "Dockerfile",
          ".dockerignore",
          "**/Dockerfile",
          "**/.dockerignore",
          "docs/deploy/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "hadolint *",
          "docker build *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "docker push*",
          "docker login*",
          "*kubectl*",
          "*terraform*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "docker build",
          "docker build *",
          "hadolint",
          "hadolint *"
        ],
        "effect": "deny"
      }
    ]
  }
}
