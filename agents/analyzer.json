{
  "name": "analyzer",
  "description": "Analisa o repositório da aplicação com a skill analisar-repo e gera docs/deploy/analise.md e docs/deploy/contexto.md. Só leitura no código, nunca lê arquivos de segredo, só escreve em docs/deploy/.",
  "prompt": "file://./instrucoes/analyzer.md",
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "write",
    "@mcp"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep",
    "code"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "docs/deploy/**"
      ]
    }
  },
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "skill://~/.kiro/skills/analisar-repo/SKILL.md",
    "file://~/.kiro/references/checklist-producao.md",
    "file://~/.kiro/references/padroes-do-time.md",
    "file://~/.kiro/templates/deploy/contexto-entrega.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "**/*.pfx",
          "**/*.p12",
          "**/*.jks",
          "**/*.keystore",
          "**/id_rsa*",
          "**/id_ed25519*",
          "**/id_ecdsa*",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfvars",
          "**/.npmrc",
          "**/.pypirc",
          "**/.netrc",
          "**/.git-credentials",
          "**/.git/config",
          "**/credentials",
          "**/credentials*.json",
          "**/secret.*",
          "**/secrets.*",
          "**/.aws/**",
          "**/.azure/**",
          "**/.kube/**",
          "**/.ssh/**",
          "**/.gnupg/**",
          "**/.docker/config.json"
        ],
        "exclude": [
          "**/.env.example",
          "**/.env.sample",
          "**/.env.template",
          "**/*.tfvars.example"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/deploy/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-docs/*",
          "microsoft-learn/*",
          "terraform/*"
        ],
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
    "fingerprint": "sha256:6fba72df627d320809c079e41bb95e295170e2df23fbf1ba1733f9be32fd6ea1",
    "source": "sha256:ed5da2b928666dc8167ea2071a17a2db68bb60be9d0d051f27ad2c2d84a0b384"
  },
  "hooks": [
    {
      "name": "guardrail-segredos",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "bash ~/.kiro/hooks/bloquear-segredos.sh"
      }
    }
  ],
  "includeMcpJson": true
}
