{
  "name": "analyzer",
  "description": "Analisa o repositório da aplicação com a skill analisar-repo e gera docs/deploy/analise.md. Só leitura no código, só escreve em docs/deploy/.",
  "prompt": "file://./instrucoes/analyzer.md",
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "write"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep",
    "code"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "docs/deploy/**"
      ]
    }
  },
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "skill://~/.kiro/skills/analisar-repo/SKILL.md",
    "file://~/.kiro/references/checklist-producao.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "docs/deploy/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 3,
