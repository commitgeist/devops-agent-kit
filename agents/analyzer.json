{
  "name": "analyzer",
  "description": "Especialista: analisa o repositório com a skill analisar-repo e gera docs/deploy/analise.md e docs/deploy/contexto.md. Só escreve em docs/deploy/.",
  "prompt": "file://./instrucoes/analyzer.md",
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "write",
    "@mcp"
  ],
  "resources": [
    "file://~/.kiro/steering/**/*.md",
    "file://~/.kiro/references/README.md",
    "file://~/.kiro/references/padroes-do-time.md",
    "file://~/.kiro/references/checklist-producao.md",
    "skill://~/.kiro/skills/analisar-repo/SKILL.md",
    "file://~/.kiro/templates/deploy/contexto-entrega.md"
  ],
  "includeMcpJson": true,
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "docs/deploy/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "aws-docs/*",
          "microsoft-learn/*",
          "terraform/*"
        ],
        "effect": "allow"
      }
    ]
  }
}
